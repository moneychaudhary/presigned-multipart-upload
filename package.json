{
  "name": "presigned-multipart-upload",
  "version": "0.1.0",
  "description": "Multipart uploads to S3 presigned URLs for React and Angular, with retry, pause, resume, cancel and checksums.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/moneychaudhary/presigned-multipart-upload#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moneychaudhary/presigned-multipart-upload.git"
  },
  "bugs": {
    "url": "https://github.com/moneychaudhary/presigned-multipart-upload/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "advanced": [
        "./dist/advanced.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      },
      "require": {
        "types": "./dist/advanced.d.cts",
        "default": "./dist/advanced.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "minio:up": "docker run -d -p 9000:9000 --user 0 --name minio-test cgr.dev/chainguard/minio@sha256:3b6e40c30ecd5cea627e382ff0b82ca841f58c52294578787043ee80c8ef7c82 server /data",
    "minio:down": "docker rm -f minio-test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "test:package": "node scripts/smoke.mjs",
    "test:docs": "node scripts/check-readme.mjs",
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "angular",
    "checksum",
    "chunked-upload",
    "crc32",
    "multipart",
    "presigned",
    "react",
    "resumable",
    "retry",
    "s3",
    "upload"
  ],
  "devDependencies": {
    "@angular/core": "^21.2.21",
    "@arethetypeswrong/cli": "^0.18.5",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/wicg-file-system-access": "^2023.10.7",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
