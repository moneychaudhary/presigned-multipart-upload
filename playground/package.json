{
  "name": "presigned-multipart-upload-playground",
  "private": true,
  "type": "module",
  "description": "Runs the library from React and Angular against S3 on LocalStack. Not published.",
  "scripts": {
    "aws:up": "docker compose up -d --wait",
    "aws:down": "docker compose down -v",
    "build:lib": "npm --prefix .. run build",
    "server": "tsx server/index.ts",
    "web": "vite",
    "dev": "npm run build:lib && concurrently -k -n api,web \"npm run server\" \"npm run web\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:lib && playwright test",
    "screenshots": "npm run build:lib && SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "presigned-multipart-upload": "file:..",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
